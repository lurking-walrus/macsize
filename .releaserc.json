{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits"
    }],
    ["@semantic-release/release-notes-generator", {
      "preset": "conventionalcommits"
    }],
    ["@semantic-release/exec", {
      "publishCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\" && echo \"tag=${nextRelease.gitTag}\" >> \"$GITHUB_OUTPUT\""
    }],
    ["@semantic-release/github", {
      "draftRelease": true,
      "releaseNameTemplate": "MacSize <%= nextRelease.version %>"
    }]
  ]
}
